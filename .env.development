# Loaded by `vite dev` / `npm run dev:harness`. The harness fires BLOCK_INIT
# from window.location.origin, which is the dev server origin pinned in
# vite.config.ts (localhost:5187).
VITE_BLOCK_ALLOWED_PARENT_ORIGINS=http://localhost:5187
# Dev uses the in-memory fake API client, so no real API base is needed.
VITE_API_BASE_URL=
